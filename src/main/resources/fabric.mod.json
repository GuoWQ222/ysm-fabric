{
  "schemaVersion": 1,
  "id": "ysm",
  "version": "${mod_version}",
  "name": "YSM for Minecraft 26.x (unofficial)",
  "description": "Unofficial port of the open-source Yes Steve Model 3.0-dev (Apache-2.0) to Minecraft 26.1-26.3 (Fabric, NeoForge, Forge). Not affiliated with or endorsed by the Yes Steve Model authors.",
  "authors": [
    "YS Group",
    "TartaricAcid",
    "TomatoPuddin",
    "AryochiL"
  ],
  "contact": {
    "sources": "https://github.com/GuoWQ222/ysm-fabric",
    "issues": "https://github.com/GuoWQ222/ysm-fabric/issues"
  },
  "license": [
    "Apache-2.0",
    "LicenseRef-All-Rights-Reserved"
  ],
  "icon": "ysm.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.elfmcys.ysm.fabric.YsmFabric"
    ],
    "client": [
      "com.elfmcys.ysm.fabric.YsmFabricClient"
    ],
    "modmenu": [
      "com.elfmcys.ysm.fabric.YsmModMenu"
    ],
    "jade": [
      "com.elfmcys.ysm.client.compat.jade.YsmJadePlugin"
    ]
  },
  "mixins": [
    "ysm.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "${mc_range}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "contributors": [
    "GuoWQ222 (26.x port)"
  ]
}
