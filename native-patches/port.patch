diff --git a/modules/gfx/src/renderer/vertex/iris_56_v2.h b/modules/gfx/src/renderer/vertex/iris_56_v2.h
new file mode 100644
index 0000000..57a3d5d
--- /dev/null
+++ b/modules/gfx/src/renderer/vertex/iris_56_v2.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <cglm/vec3.h>
+
+namespace ysm::gfx::renderer::vertex {
+#pragma pack(push, 1)
+// Iris 1.11 (Minecraft 26.x) IrisVertexFormats.ENTITY: iris_Entity is RGBA16_UINT (entity, block entity, item, 0),
+// so mc_midTexCoord starts at byte 44 and at_tangent at byte 52, with no trailing padding.
+struct Iris56V2Vertex {
+    static constexpr size_t kSize = 56;
+
+    vec3 pos{};
+    uint32_t color = 0;
+    vec2 tex_uv{};
+
+    uint32_t overlay = 0;
+    uint32_t light = 0;
+
+    uint32_t normal = 0;
+
+    // iris extended
+    uint16_t entity_id[4]{};
+    vec2 mid_tex_uv{};
+    uint32_t tangent = 0;
+
+    void SetVertex(float x, float y, float z, const vec2 uv) noexcept {
+        pos[0] = x;
+        pos[1] = y;
+        pos[2] = z;
+        tex_uv[0] = uv[0];
+        tex_uv[1] = uv[1];
+    }
+
+    void SetColor(uint32_t value) noexcept {
+        color = value;
+    }
+
+    void SetOverlay(uint32_t value) noexcept {
+        overlay = value;
+    }
+
+    void SetLight(uint32_t value) noexcept {
+        light = value;
+    }
+
+    void SetNormal(uint32_t value) noexcept {
+        normal = value;
+    }
+
+    void SetIrisEntityId(uint64_t value) noexcept {
+        std::memcpy(entity_id, &value, 6);
+        entity_id[3] = 0;
+    }
+
+    void SetIrisMidUV(const vec2 value) noexcept {
+        mid_tex_uv[0] = value[0];
+        mid_tex_uv[1] = value[1];
+    }
+
+    void SetIrisTangent(uint32_t value) noexcept {
+        tangent = value;
+    }
+};
+#pragma pack(pop)
+
+static_assert(sizeof(Iris56V2Vertex) == Iris56V2Vertex::kSize);
+}
