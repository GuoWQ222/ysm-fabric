# Forge 48 / early 49 (Minecraft 1.20.2, 1.20.3): one tick event per kind with a phase field (no Pre / Post
# sub-events). After forge-eventbus6, whose listeners name the event type.
regex	\(\((net\.minecraftforge\.event\.TickEvent\.\w+)\.Pre (\w+)\) -> \{	(($1 $2) -> { if ($2.phase != net.minecraftforge.event.TickEvent.Phase.START) return;
regex	\(\((net\.minecraftforge\.event\.TickEvent\.\w+)\.Post (\w+)\) -> \{	(($1 $2) -> { if ($2.phase != net.minecraftforge.event.TickEvent.Phase.END) return;
